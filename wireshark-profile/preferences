# Wireshark profile for the ESP32-C6 sniffer.
#
# Adds the radio metadata as columns. Without these the channel, signal
# strength and link quality are captured and dissected but invisible unless you
# click into each frame, which is most of what makes a raw capture unreadable.
#
# Each column names the field for every radio, separated by " or ", because
# this board has three and they use different ones. The 802.15.4-only version
# of this profile left the Ch and RSSI columns EMPTY on a Wi-Fi or BLE capture,
# which reads as "the sniffer did not record it" rather than "the profile is
# looking in the wrong place".
#
# frame.interface_name is included for running several boards at once: Wireshark
# tags every packet with its source interface, so a multi-board capture stays
# attributable.

gui.column.format:
	"No.", "%m",
	"Time", "%t",
	"Ch", "%Cus:wpan-tap.ch_num or wlan_radio.channel:0:R",
	"RSSI", "%Cus:wpan-tap.rss or radiotap.dbm_antsignal or bthci_evt.rssi:0:R",
	"LQI", "%Cus:wpan-tap.lqi:0:R",
	"Rate", "%Cus:wlan_radio.data_rate:0:R",
	"Iface", "%Cus:frame.interface_name:0:R",
	"Source", "%s",
	"Destination", "%d",
	"Protocol", "%p",
	"Len", "%L",
	"Info", "%i"

# Thread's dissector can work out the key sequence counter itself once it has
# seen enough traffic.
thread.thr_auto_acq_thr_seq_ctr: TRUE
