# "ESP32-C6 Sniffer" profile settings file for Wireshark.
#
# Selects this profile automatically when a capture comes from this sniffer,
# so the columns and colouring are right without anyone remembering to
# right-click the status bar first.
#
# The filter works because our captures name their interface: the pcapng
# writer puts if_name in the interface header, so every frame carries
# frame.interface_name. Measured against real files -- it matches 135 of 135
# 802.15.4 frames, 1414 of 1414 Wi-Fi and 511 of 511 BLE, and none at all of
# an ordinary pcap from anywhere else, which has no interface name to match.

# Automatically switch to this profile if this display filter matches
auto_switch_filter: frame.interface_name contains "esp32c6"
